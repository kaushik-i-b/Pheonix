# ---------------------------------------------------------------------------
# Phoenix configuration
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- LLM provider (any OpenAI-compatible endpoint) --------------------------
# Hosted Qwen (DashScope compatible mode):
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen3-coder-plus
# Local vLLM:        LLM_BASE_URL=http://localhost:8000/v1
# Local Ollama:      LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# Local 7B models need minutes, not seconds, for a full structured report; a cold model adds load
# time and prefill on top. Size for the slowest legitimate generation, not the warm average.
LLM_TIMEOUT_MS=900000
# One retry: a second full attempt of a multi-minute generation doubles an already long stage.
LLM_MAX_RETRIES=1
LLM_CONCURRENCY=2
# Backend-specific request fields, merged into the chat-completions body. One client serves every
# OpenAI-compatible endpoint, so the knobs only one backend understands live here:
#   Ollama (raise the 4096-token default context, keep the model warm between stages):
#     LLM_EXTRA_BODY={"options":{"num_ctx":32768},"keep_alive":"30m"}
#   vLLM (constrain decoding):                      LLM_EXTRA_BODY={"guided_decoding":{"json":...}}
# LLM_EXTRA_BODY=

# --- Phoenix metadata database (PostgreSQL) ---------------------------------
PHOENIX_DATABASE_URL=postgres://phoenix:phoenix@localhost:5432/phoenix
PHOENIX_DB_MIGRATE=true

# --- Run workspace ----------------------------------------------------------
PHOENIX_ARTIFACT_ROOT=./artifacts
PHOENIX_WORKSPACE_ROOT=./.phoenix-workspaces

# --- Orchestration limits ---------------------------------------------------
MAX_REPAIR_ITERATIONS=3
MAX_TOTAL_TOOL_CALLS=1200
MAX_AGENT_STEPS=40
STAGE_TIMEOUT_MS=1800000

# --- Legacy system under modernization (demo) -------------------------------
LEGACY_BANK_DB_URL=postgres://legacy:legacy@localhost:5432/legacy_bank
LEGACY_BANK_PORT=8080
MODERN_BANK_PORT=8090

# --- Tool security ----------------------------------------------------------
SANDBOX_ALLOW_NETWORK=false
SANDBOX_DEFAULT_TIMEOUT_MS=120000
SANDBOX_MAX_OUTPUT_BYTES=1048576

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_EVENT_MIRROR=true
