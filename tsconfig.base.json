{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@phoenix/shared": ["./packages/shared/src/index.ts"],
      "@phoenix/config": ["./packages/config/src/index.ts"],
      "@phoenix/llm": ["./packages/llm/src/index.ts"],
      "@phoenix/llm/testing": ["./packages/llm/src/mock.ts"],
      "@phoenix/artifact-store": ["./packages/artifact-store/src/index.ts"],
      "@phoenix/execution-sandbox": ["./packages/execution-sandbox/src/index.ts"],
      "@phoenix/repository-tools": ["./packages/repository-tools/src/index.ts"],
      "@phoenix/agent-runtime": ["./packages/agent-runtime/src/index.ts"],
      "@phoenix/legacy-analysis": ["./packages/legacy-analysis/src/index.ts"],
      "@phoenix/specification": ["./packages/specification/src/index.ts"],
      "@phoenix/characterization": ["./packages/characterization/src/index.ts"],
      "@phoenix/differential-testing": ["./packages/differential-testing/src/index.ts"],
      "@phoenix/adversarial-testing": ["./packages/adversarial-testing/src/index.ts"],
      "@phoenix/verification": ["./packages/verification/src/index.ts"],
      "@phoenix/orchestrator": ["./packages/orchestrator/src/index.ts"],
      "@phoenix/api": ["./apps/api/src/index.ts"],
      "@phoenix/worker": ["./apps/worker/src/index.ts"],
      "@phoenix/cli": ["./apps/cli/src/index.ts"]
    }
  }
}
